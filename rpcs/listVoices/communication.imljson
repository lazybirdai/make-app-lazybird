{
	"url": "/voices",
	"method": "GET",
	"qs": {
		"section": "{{ifempty(parameters.section, 'library')}}",
		"q": "{{parameters.q}}",
		"language": "{{parameters.language}}",
		"gender": "{{parameters.gender}}",
		"limit": 50
	},
	"response": {
		"limit": 50,
		"iterate": "{{get(body, ifempty(parameters.section, 'library'))}}",
		"output": {
			"label": "{{item.displayName}}",
			"value": "{{item.id}}"
		}
	}
}
