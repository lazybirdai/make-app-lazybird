{
	"url": "https://api.lazybird.app/v2/me",
	"method": "GET",
	"headers": {
		"X-API-Key": "{{parameters.apiKey}}"
	},
	"log": {
		"sanitize": [
			"request.headers.x-api-key"
		]
	},
	"response": {
		"uid": "{{body.userId}}",
		"metadata": {
			"type": "email",
			"value": "{{body.email}}"
		},
		"error": {
			"type": "InvalidAccessTokenError",
			"message": "[{{statusCode}}] {{ifempty(body.error, body)}}"
		}
	}
}
